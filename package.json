{
  "name": "kshorts-desktop",
  "version": "1.4.16",
  "description": "K-Shorts Studio - 한국어 AI 쇼츠 자동화 제작 데스크톱 프로그램",
  "author": "K-Shorts Studio Team",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node scripts/launcher.js",
    "app": "node scripts/launcher.js",
    "dev": "node scripts/launcher.js --dev",
    "dev:electron": "node scripts/launcher.js --dev",
    "build:electron": "node scripts/build-electron.js",
    "build:vite": "vite build",
    "build": "npm run build:vite && npm run build:electron",
    "checksum": "node scripts/make-checksum.js",
    "pack:win": "node scripts/run-edition.js buyer npm run build && electron-builder --win --dir",
    "dist:win": "node scripts/run-edition.js buyer npm run build && electron-builder --win nsis && node scripts/make-checksum.js",
    "release": "npm run dist:win && node scripts/publish-release.js",
    "dist": "node scripts/run-edition.js buyer npm run build && electron-builder --win nsis && node scripts/make-checksum.js",
    "build:buyer": "node scripts/run-edition.js buyer npm run build",
    "test": "npm run build && node scripts/test-features-runtime.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.kshorts.studio",
    "productName": "K-Shorts Studio",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "K-Shorts Studio",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "public/bgm/**",
      "public/sfx/**",
      "dist/bgm/**",
      "dist/sfx/**"
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.0",
    "@esbuild/win32-x64": "^0.25.12",
    "@rollup/rollup-linux-x64-gnu": "^4.34.8",
    "@rollup/rollup-win32-x64-msvc": "^4.63.1"
  }
}
